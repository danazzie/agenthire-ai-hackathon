# Copy to .env and fill in. .env is gitignored. Sandbox credentials only.

# --- PayPal sandbox: the platform's REST app ---------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> (your app)
# The app's sandbox business account is the platform: both holds are created
# under it, and Payouts are sent from it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Two sandbox personal accounts (US-29) -----------------------------------
# developer.paypal.com -> Testing Tools -> Sandbox Accounts. Country: United States
# (India-registered sandbox accounts can fail checkout).
PAYPAL_BUYER_EMAIL=
PAYPAL_SELLER_EMAIL=

# --- Claude (negotiating agents, verifier compiler, evidence packet) ---------
ANTHROPIC_API_KEY=
