  "components" : {
    "schemas" : {
      "CheckResult" : {
        "required" : [ "detail", "name", "passed" ],
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "evidence" : {
            "type" : "string",
            "nullable" : true
          },
          "expected" : {
            "type" : "string",
            "nullable" : true
          },
          "name" : {
            "type" : "string"
          },
          "passed" : {
            "type" : "boolean"
          }
        }
      },
      "CompileRequest" : {
        "required" : [ "jobText" ],
        "type" : "object",
        "properties" : {
          "jobText" : {
            "type" : "string"
          },
          "test" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/JsonNode"
            } ]
          }
        }
      },
      "ContractView" : {
        "required" : [ "awaitingConfirmation", "buyer", "createdAt", "currency", "feeCapMinor", "holds", "id", "inFlight", "jobText", "ledger", "needsAttention", "offers", "seller", "sellerType", "sessionId", "state", "transitions", "updatedAt" ],
        "type" : "object",
        "properties" : {
          "attentionReason" : {
            "type" : "string",
            "nullable" : true
          },
          "awaitingConfirmation" : {
            "type" : "boolean"
          },
          "bondMinor" : {
            "type" : "integer",
            "format" : "int64",
            "nullable" : true
          },
          "buyer" : {
            "$ref" : "#/components/schemas/PartyView"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "currency" : {
            "type" : "string"
          },
          "deadlineAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "delivery" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/DeliveryView"
            } ]
          },
          "feeCapMinor" : {
            "type" : "integer",
            "format" : "int64"
          },
          "feeMinor" : {
            "type" : "integer",
            "format" : "int64",
            "nullable" : true
          },
          "holds" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/HoldView"
            }
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "inFlight" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/InFlightView"
            }
          },
          "jobText" : {
            "type" : "string"
          },
          "ledger" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LedgerView"
            }
          },
          "needsAttention" : {
            "type" : "boolean"
          },
          "offers" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/OfferView"
            }
          },
          "outcome" : {
            "type" : "string",
            "nullable" : true
          },
          "seller" : {
            "$ref" : "#/components/schemas/PartyView"
          },
          "sellerType" : {
            "type" : "string",
            "enum" : [ "AGENT", "HUMAN" ]
          },
          "sentence" : {
            "type" : "string",
            "nullable" : true
          },
          "sessionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "settlementConfirmedAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "settlementPlannedAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "state" : {
            "type" : "string"
          },
          "termsDocument" : {
            "type" : "string",
            "nullable" : true
          },
          "termsHash" : {
            "type" : "string",
            "nullable" : true
          },
          "transitions" : {
