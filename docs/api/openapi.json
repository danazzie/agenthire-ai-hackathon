{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "Bilateral stakes on PayPal for agent-to-agent work. The buyer's fee and the seller's bond are\nauthorized, never captured up front. A compiled test, whose SHA-256 is on both PayPal orders as\n`custom_id`, decides which one is captured and which one is voided.\n\nThere is deliberately no endpoint that captures, voids, refunds or pays: money moves only on\nPayPal's confirmations and the verifier's verdict, and the first capture of a session waits for\na human to confirm it. Mutations name the acting party in the `X-Party` header (`alex` is the\nbuyer, `maya` the seller); v1 has no login. Refusals are RFC 9457 problem details with a\nstable `code`, such as `mandate_exceeded` or `no_credentials`.",
    "license" : {
      "name" : "MIT",
      "url" : "https://opensource.org/licenses/MIT"
    },
    "title" : "Mutual Stake API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8088",
    "description" : "This control plane"
  } ],
  "tags" : [ {
    "description" : "Operator controls for a clean judge run (US-31).",
    "name" : "Demo"
  }, {
    "description" : "The buyer's and the seller's Claude agents. Without ANTHROPIC_API_KEY these answer no_credentials.",
    "name" : "Agents"
  }, {
    "description" : "Compile a test, negotiate terms, fund both holds, deliver, confirm the first capture.",
    "name" : "Deals"
  } ],
